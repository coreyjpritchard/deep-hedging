{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deephedge.graph/v1",
  "title": "deep-hedging graph spec, deephedge.graph/v1",
  "description": "Generated by `python -m deephedge.registry`. Structural checks only; deephedge.spec.validate checks wiring, widths and seed distinctness.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "deephedge.graph/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "seeds": {
      "type": "object",
      "properties": {
        "train": {
          "type": "integer",
          "minimum": 0
        },
        "validation": {
          "type": "integer",
          "minimum": 0
        },
        "test": {
          "type": "integer",
          "minimum": 0
        },
        "torch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "train",
        "validation",
        "test",
        "torch"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "contract.vanilla"
              },
              "params": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "call",
                      "put"
                    ]
                  },
                  "strike": {
                    "type": "number",
                    "exclusiveMinimum": 0.0
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "cost.fixed_plus_proportional"
              },
              "params": {
                "type": "object",
                "properties": {
                  "fixed": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0.0
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": 0.0
                        },
                        "minItems": 1
                      }
                    ]
                  },
                  "rate": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0.0
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": 0.0
                        },
                        "minItems": 1
                      }
                    ]
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0.0,
                    "description": "tanh surrogate width used in training"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "cost.proportional"
              },
              "params": {
                "type": "object",
                "properties": {
                  "rate": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0.0
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": 0.0
                        },
                        "minItems": 1
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "cost.quadratic"
              },
              "params": {
                "type": "object",
                "properties": {
                  "impact": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0.0
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": 0.0
                        },
                        "minItems": 1
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "evaluator.compare"
              },
              "params": {
                "type": "object",
                "properties": {
                  "bootstrap": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "bootstrap resamples, 0 for none"
                  },
                  "level": {
                    "type": "number",
                    "exclusiveMinimum": 0.0,
                    "exclusiveMaximum": 1.0
                  },
                  "report": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "mean",
                        "std",
                        "cvar",
                        "entropic",
                        "mean_variance",
                        "turnover",
                        "cost"
                      ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "features.concat"
              },
              "params": {
                "type": "object",
                "properties": {
                  "blocks": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "time",
                        "spot",
                        "log_moneyness",
                        "variance",
                        "prev_position"
                      ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false,
                "required": [
                  "blocks"
                ]
              }
            },
            "required": [
              "type",
              "params"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "generator.black_scholes"
              },
              "params": {
                "type": "object",
                "properties": {
                  "maturity": {
                    "type": "number",
                    "exclusiveMinimum": 0.0,
                    "description": "years"
                  },
                  "mu": {
                    "type": "number",
                    "description": "drift of the simulation measure"
                  },
                  "r": {
                    "type": "number",
                    "description": "risk-free rate, continuously compounded"
                  },
                  "s0": {
                    "type": "number",
                    "exclusiveMinimum": 0.0,
                    "description": "spot at t = 0"
                  },
                  "sigma": {
                    "type": "number",
                    "exclusiveMinimum": 0.0
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "generator.heston"
              },
              "params": {
                "type": "object",
                "properties": {
                  "kappa": {
                    "type": "number",
                    "exclusiveMinimum": 0.0
                  },
                  "kappa_sim": {
                    "oneOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0.0
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "simulation kappa; unset means kappa"
                  },
                  "maturity": {
                    "type": "number",
                    "exclusiveMinimum": 0.0,
                    "description": "years"
                  },
                  "mu": {
                    "type": "number",
                    "description": "drift of the simulation measure"
                  },
                  "n_cos": {
                    "type": "integer",
                    "minimum": 16,
                    "description": "COS terms along a path"
                  },
                  "r": {
                    "type": "number",
                    "description": "risk-free rate, continuously compounded"
                  },
                  "rho": {
                    "type": "number",
                    "minimum": -1.0,
                    "maximum": 1.0
                  },
                  "s0": {
                    "type": "number",
                    "exclusiveMinimum": 0.0,
                    "description": "spot at t = 0"
                  },
                  "theta": {
                    "type": "number",
                    "minimum": 0.0
                  },
                  "theta_sim": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0.0
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "simulation theta; unset means theta"
                  },
                  "truncation": {
                    "type": "number",
                    "exclusiveMinimum": 0.0,
                    "description": "COS range in standard deviations"
                  },
                  "v0": {
                    "type": "number",
                    "minimum": 0.0
                  },
                  "xi": {
                    "type": "number",
                    "minimum": 0.0,
                    "description": "vol of vol; 0 is the Black-Scholes limit"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "generator.rough_bergomi"
              },
              "params": {
                "type": "object",
                "properties": {
                  "H": {
                    "type": "number",
                    "exclusiveMinimum": 0.0,
                    "exclusiveMaximum": 1.0,
                    "description": "Hurst exponent"
                  },
                  "maturity": {
                    "type": "number",
                    "exclusiveMinimum": 0.0,
                    "description": "years"
                  },
                  "nu": {
                    "type": "number",
                    "minimum": 0.0,
                    "description": "annual vol of vol"
                  },
                  "rho": {
                    "type": "number",
                    "minimum": -1.0,
                    "maximum": 0.0
                  },
                  "s0": {
                    "type": "number",
                    "exclusiveMinimum": 0.0,
                    "description": "spot at t = 0"
                  },
                  "xi0": {
                    "type": "number",
                    "exclusiveMinimum": 0.0,
                    "description": "flat initial forward variance"
                  },
                  "xi_tenors": {
                    "oneOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "exclusiveMinimum": 0.0
                        },
                        "minItems": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "hedger.delta"
              },
              "params": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "hedger.delta_vega"
              },
              "params": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "hedger.feature_mlp"
              },
              "params": {
                "type": "object",
                "properties": {
                  "activation": {
                    "type": "string",
                    "enum": [
                      "relu",
                      "tanh",
                      "silu"
                    ]
                  },
                  "depth": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "n_in": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "checked against the features width"
                  },
                  "n_out": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "checked against the instrument count"
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "hedger.gru"
              },
              "params": {
                "type": "object",
                "properties": {
                  "hidden": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "n_in": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "checked against the features width"
                  },
                  "n_out": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "checked against the instrument count"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "hedger.whalley_wilmott"
              },
              "params": {
                "type": "object",
                "properties": {
                  "risk_aversion": {
                    "type": "number",
                    "exclusiveMinimum": 0.0,
                    "description": "gamma in the band formula"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "instruments"
              },
              "params": {
                "type": "object",
                "properties": {
                  "names": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false,
                "required": [
                  "names"
                ]
              }
            },
            "required": [
              "type",
              "params"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "objective.cvar"
              },
              "params": {
                "type": "object",
                "properties": {
                  "alpha": {
                    "type": "number",
                    "exclusiveMinimum": 0.0,
                    "exclusiveMaximum": 1.0
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "objective.entropic"
              },
              "params": {
                "type": "object",
                "properties": {
                  "lam": {
                    "type": "number",
                    "exclusiveMinimum": 0.0
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "objective.mean_variance"
              },
              "params": {
                "type": "object",
                "properties": {
                  "lam": {
                    "type": "number",
                    "exclusiveMinimum": 0.0
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "run": {
      "type": "object",
      "properties": {
        "batch": {
          "type": "integer",
          "minimum": 1
        },
        "epochs": {
          "type": "integer",
          "minimum": 0
        },
        "lr": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "m_test": {
          "type": "integer",
          "minimum": 1,
          "description": "test paths"
        },
        "m_train": {
          "type": "integer",
          "minimum": 1,
          "description": "training paths"
        },
        "m_validation": {
          "type": "integer",
          "minimum": 1,
          "description": "validation paths"
        },
        "mc_fallback": {
          "type": "boolean",
          "description": "allow Monte Carlo greeks for classical hedgers without a pricer"
        },
        "n_steps": {
          "type": "integer",
          "minimum": 1,
          "description": "hedging dates from 0 to maturity"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "seeds",
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
